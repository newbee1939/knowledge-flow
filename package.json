{
  "name": "knowledge-flow",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "articles": "node scripts/articles-index.ts",
    "postinstall": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "astro": "7.2.9",
    "github-slugger": "2.0.0",
    "playwright": "1.62.1",
    "rehype-mermaid": "3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
