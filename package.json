{
  "name": "knowledge-flow",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "articles": "node scripts/articles-index.ts",
    "postinstall": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5",
    "github-slugger": "2.0.0",
    "playwright": "1.63.0",
    "rehype-mermaid": "3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
