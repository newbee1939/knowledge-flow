---
import { formatDate } from '../lib/date';

// 1 か月分のカードを横スクロールで並べる帯。トップページ（日次レポート）と
// カテゴリページ（記事）で見た目を揃えるため、両者から使う。
interface Props {
	items: { href: string; date: Date; title: string }[];
}

const { items } = Astro.props;
---

<ol class="day-strip">
	{
		items.map(({ href, date, title }) => (
			<li class="day-card">
				<a href={href} title={title}>
					<time datetime={date.toISOString()}>{formatDate(date)}</time>
					<span class="day-title">{title}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.day-strip {
		display: flex;
		gap: var(--space-sm);
		margin: 0;
		padding: 0 0 var(--space-xs);
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
	}

	.day-card {
		flex: 0 0 17rem;
		scroll-snap-align: start;
	}

	.day-card a {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		height: 100%;
		border-left: 1px solid var(--color-border);
		padding: var(--space-2xs) var(--space-md) var(--space-xs);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.day-card a:hover {
		border-left-color: var(--color-accent);
	}

	.day-card a:hover .day-title {
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.day-card time {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.day-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.75;
	}

	@media (max-width: 40rem) {
		.day-card {
			flex-basis: 15rem;
		}
	}
</style>
