---
import { formatDate } from '../lib/date';
import { getPeriodKey } from '../lib/periods';
import { getPeriods } from '../lib/posts';
import { getPeriodTitle } from '../lib/summaries';
import { buildTimeline } from '../lib/timeline';
import { withBase } from '../lib/url';

// 年 → 月 → 日カード（横スクロール）の年表。トップページとカテゴリページで共用する。
interface Props {
	items: { href: string; date: Date; title: string }[];
	/** 指定するとそのカテゴリのひとことタイトルを引く。省略時はサイト全体のもの */
	category?: string;
}

const { items, category } = Astro.props;

// まとめ記事のある期間は、年・月ラベル自体をその記事へのリンクにする。
// まとめはサイト全体を対象に書かれるため、カテゴリページでは貼らない。
const periodIds = new Set(category === undefined ? (await getPeriods()).map((p) => p.id) : []);
const getPeriodHref = (year: number, month?: number) => {
	const key = getPeriodKey({ year, month });
	return periodIds.has(key) ? withBase(`periods/${key}/`) : undefined;
};

// ひとことタイトルはテンプレートで引かず、ここで畳んでおく（同じ呼び出しを 2 度書かない）
const timeline = buildTimeline(items).map((year) => ({
	...year,
	title: getPeriodTitle({ year: year.year, category }),
	href: getPeriodHref(year.year),
	months: year.months.map((month) => ({
		...month,
		title: getPeriodTitle({ year: year.year, month: month.month, category }),
		href: getPeriodHref(year.year, month.month),
	})),
}));
---

{
	timeline.map(({ year, title: yearTitle, href: yearHref, months }) => (
		<section class="year">
			<h2 class="year-label">
				{yearHref ? <a href={yearHref}>{year}</a> : year}
				{yearTitle && <span class="period-title">{yearTitle}</span>}
			</h2>
			{months.map(({ month, title: monthTitle, href: monthHref, entries }) => (
				<section class="month">
					<h3 class="month-label">
						{monthHref ? (
							<a href={monthHref}>{String(month).padStart(2, '0')}</a>
						) : (
							String(month).padStart(2, '0')
						)}
						{monthTitle && <span class="period-title">{monthTitle}</span>}
					</h3>
					<ol class="day-strip">
						{entries.map(({ href, date, title }) => (
							<li class="day-card">
								<a href={href} title={title}>
									<time datetime={date.toISOString()}>{formatDate(date)}</time>
									<span class="day-title">{title}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			))}
		</section>
	))
}

<style>
	.year {
		margin-top: var(--space-xl);
	}

	/* 年の下に罫線は引かない。直後の月ラベルが罫線を持つため二重線になる。 */
	.year-label {
		display: flex;
		align-items: baseline;
		gap: var(--space-md);
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	/* まとめ記事へのリンク。通常時は年月ラベルの見た目を統一するため下線を出さず、ホバー時だけ出す */
	.year-label a,
	.month-label a {
		color: inherit;
		text-decoration: none;
	}

	.year-label a:hover,
	.month-label a:hover {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.month {
		margin-top: var(--space-lg);
	}

	.month-label {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin: 0 0 var(--space-md);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
	}

	.month-label::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--color-border);
	}

	/* 年月の数字（等幅・字間広め）と地続きに見えないよう、和文は本文の書体に戻す */
	.period-title {
		flex: 0 1 auto;
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0;
	}

	.year-label .period-title {
		font-size: var(--text-sm);
	}

	/* 月ごとの横スクロール領域。カードは日単位 */
	.day-strip {
		display: flex;
		gap: var(--space-sm);
		margin: 0;
		padding: 0 0 var(--space-xs);
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
	}

	.day-card {
		flex: 0 0 17rem;
		scroll-snap-align: start;
	}

	.day-card a {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		height: 100%;
		border-left: 1px solid var(--color-border);
		padding: var(--space-2xs) var(--space-md) var(--space-xs);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.day-card a:hover {
		border-left-color: var(--color-accent);
	}

	.day-card a:hover .day-title {
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.day-card time {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.day-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.75;
	}

	@media (max-width: 40rem) {
		.day-card {
			flex-basis: 15rem;
		}
	}
</style>
