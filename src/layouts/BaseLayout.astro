---
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Daily Tech Report' } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-name" href={withBase('/')}>knowledge-flow</a>
			<nav class="site-nav">
				<a href={withBase('categories/')}>Categories</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p class="disclosure">
				本サイトの記事は、公開されている記事をもとに AI が要約して自動生成しています。内容の正確性は保証できません。詳細は各記事のリンク先で原文をご確認ください。
			</p>
			<p class="disclosure" lang="en">
				The articles on this site are automatically generated: an AI summarizes publicly available
				articles. Accuracy is not guaranteed — please read the original source linked in each item.
			</p>
			<p class="copyright">© {new Date().getFullYear()} knowledge-flow</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: var(--space-lg) var(--space-lg) var(--space-md);
	}

	/* 色を変えるだけの hover は素っ気ないので、下線を引いて「押せる」ことを示す。
	 * 平常時に下線を出さないぶん、ヘッダーの静けさは保てる。 */
	.site-header a {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		text-decoration: none;
		text-underline-offset: 0.35em;
		text-decoration-thickness: 1px;
	}

	.site-header a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-nav a {
		color: var(--color-text-muted);
	}

	.site-name {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	main {
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: 0 var(--space-lg) var(--space-2xl);
	}

	.site-footer {
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: var(--space-lg) var(--space-lg) var(--space-xl);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}

	.site-footer p {
		margin: 0;
	}

	.disclosure {
		max-width: 58ch;
		margin-bottom: var(--space-sm);
		line-height: 1.9;
	}

	.copyright {
		margin-top: var(--space-md);
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
	}

	@media (max-width: 40rem) {
		.site-header,
		main,
		.site-footer {
			padding-inline: var(--space-md);
		}
	}
</style>
