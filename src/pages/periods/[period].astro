---
import { render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { periodLabel } from '../../lib/periods';
import { getPeriods } from '../../lib/posts';

export async function getStaticPaths() {
	const periods = await getPeriods();
	return periods.map((period) => ({
		params: { period: period.id },
		props: { period },
	}));
}

const { period } = Astro.props;
const { Content } = await render(period);
---

<BaseLayout title={period.data.title}>
	<article class="post">
		<header class="post-header">
			<span class="post-period">{periodLabel(period.id)}</span>
			<h1>{period.data.title}</h1>
			<time datetime={period.data.date.toISOString()}>{formatDate(period.data.date)}</time>
		</header>
		<Prose>
			<Content />
		</Prose>
	</article>
</BaseLayout>

<style>
	.post {
		max-width: var(--container-article);
		margin-inline: auto;
		padding-top: var(--space-xl);
	}

	.post-period {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
	}

	.post-header h1 {
		margin: var(--space-xs) 0 0;
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: 1.55;
		letter-spacing: -0.01em;
	}

	.post-header time {
		display: block;
		margin-top: var(--space-sm);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}
</style>
