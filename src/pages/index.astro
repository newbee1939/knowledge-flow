---
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { getPosts } from '../lib/posts';
import { withBase } from '../lib/url';

// タイムラインは posts からビルド時に導出する（設計原則 Derived-not-Generated）。
// docs/blog/posts/ に md を 1 枚足すだけで、コードを変えずにカードが増える。
const posts = await getPosts();
const latestPost = posts[0];
---

<BaseLayout title="knowledge-flow">
	<a class="latest" href={withBase(`blog/${latestPost.id}/`)}>
		<span class="latest-label">Latest Post</span>
		<h1 class="latest-title">{latestPost.data.title}</h1>
		<time class="latest-date" datetime={latestPost.data.date.toISOString()}>
			{formatDate(latestPost.data.date)}
		</time>
	</a>
	<Timeline
		items={posts.map((post) => ({
			href: withBase(`blog/${post.id}/`),
			date: post.data.date,
			title: post.data.title,
		}))}
	/>
</BaseLayout>

<style>
	.latest {
		display: block;
		margin-top: var(--space-md);
		border-top: 2px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-md) 0 var(--space-lg);
		text-decoration: none;
	}

	.latest-label {
		display: inline-block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.latest-title {
		margin: var(--space-xs) 0 0;
		max-width: 26em;
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.latest:hover .latest-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	.latest-date {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
</style>
