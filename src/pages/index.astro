---
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { periodLabel } from '../lib/periods';
import { getPeriods, getPosts } from '../lib/posts';
import { withBase } from '../lib/url';

// タイムラインは posts からビルド時に導出する（設計原則 Derived-not-Generated）。
// docs/blog/posts/ に md を 1 枚足すだけで、コードを変えずにカードが増える。
const posts = await getPosts();
const latestPost = posts[0];

// 月・年のまとめ記事は、書かれた日だけ最新記事の下に並べる。翌日のレポートが入れば
// 自然に消え、以降は年表の年・月ラベル（Timeline.astro）から辿れる。
const newPeriods = (await getPeriods()).filter(
	(period) => period.data.date.getTime() >= latestPost.data.date.getTime(),
);
---

<BaseLayout title="knowledge-flow">
	{
		newPeriods.length > 0 && (
			<ul class="summaries">
				{newPeriods.map((period) => (
					<li class="summary">
						<a href={withBase(`periods/${period.id}/`)}>
							<span class="summary-kicker">Summary</span>
							<span class="summary-label">{periodLabel(period.id)}</span>
							<span class="summary-title">{period.data.title}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
	<a class="latest" href={withBase(`blog/${latestPost.id}/`)}>
		<span class="latest-label">Latest Post</span>
		<h1 class="latest-title">{latestPost.data.title}</h1>
		<time class="latest-date" datetime={latestPost.data.date.toISOString()}>
			{formatDate(latestPost.data.date)}
		</time>
	</a>
	<Timeline
		items={posts.map((post) => ({
			href: withBase(`blog/${post.id}/`),
			date: post.data.date,
			title: post.data.title,
		}))}
	/>
</BaseLayout>

<style>
	.latest {
		display: block;
		margin-top: var(--space-md);
		border-top: 2px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-md) 0 var(--space-lg);
		text-decoration: none;
	}

	.latest-label {
		display: inline-block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.latest-title {
		margin: var(--space-xs) 0 0;
		max-width: 26em;
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.latest:hover .latest-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	/* 月・年のまとめは書いた日だけ最上段に出る特別枠。日次レポートの見出しに埋もれないよう、
	 * ここだけアクセント色の帯を敷いて紙面のトップ記事のように扱う。 */
	.summaries {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-sm);
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
	}

	.summary a {
		display: block;
		height: 100%;
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-accent);
		border-radius: var(--radius);
		padding: var(--space-md) var(--space-md) var(--space-lg);
		background: var(--color-surface);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.summary a:hover {
		border-color: var(--color-accent);
	}

	.summary-kicker {
		display: block;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.summary-label {
		display: block;
		margin-top: var(--space-2xs);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	.summary a:hover .summary-label {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.summary-title {
		display: block;
		margin-top: var(--space-xs);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: 1.75;
	}

	.latest-date {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
</style>
