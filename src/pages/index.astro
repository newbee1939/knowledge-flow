---
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { periodLabel } from '../lib/periods';
import { getPeriods, getPosts } from '../lib/posts';
import { withBase } from '../lib/url';

// タイムラインは posts からビルド時に導出する（設計原則 Derived-not-Generated）。
// docs/blog/posts/ に md を 1 枚足すだけで、コードを変えずにカードが増える。
const posts = await getPosts();
const latestPost = posts[0];

// 月・年のまとめ記事は、書かれた日だけ最新記事の下に並べる。翌日のレポートが入れば
// 自然に消え、以降は年表の年・月ラベル（Timeline.astro）から辿れる。
const newPeriods = (await getPeriods()).filter(
	(period) => period.data.date.getTime() >= latestPost.data.date.getTime(),
);
---

<BaseLayout title="knowledge-flow">
	<a class="latest" href={withBase(`blog/${latestPost.id}/`)}>
		<span class="latest-label">Latest Post</span>
		<h1 class="latest-title">{latestPost.data.title}</h1>
		<time class="latest-date" datetime={latestPost.data.date.toISOString()}>
			{formatDate(latestPost.data.date)}
		</time>
	</a>
	{
		newPeriods.length > 0 && (
			<ul class="new-periods">
				{newPeriods.map((period) => (
					<li>
						<a href={withBase(`periods/${period.id}/`)} title={period.data.title}>
							{periodLabel(period.id)}
						</a>
					</li>
				))}
			</ul>
		)
	}
	<Timeline
		items={posts.map((post) => ({
			href: withBase(`blog/${post.id}/`),
			date: post.data.date,
			title: post.data.title,
		}))}
	/>
</BaseLayout>

<style>
	.latest {
		display: block;
		margin-top: var(--space-md);
		border-top: 2px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-md) 0 var(--space-lg);
		text-decoration: none;
	}

	.latest-label {
		display: inline-block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.latest-title {
		margin: var(--space-xs) 0 0;
		max-width: 26em;
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.latest:hover .latest-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	.new-periods {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
	}

	.new-periods a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.new-periods a:hover {
		color: var(--color-accent);
		text-decoration-color: var(--color-accent);
	}

	.latest-date {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
</style>
