---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { getPosts } from '../lib/posts';
import { buildTimeline } from '../lib/timeline';
import { withBase } from '../lib/url';

// タイムラインは posts からビルド時に導出する（設計原則 Derived-not-Generated）。
// docs/blog/posts/ に md を 1 枚足すだけで、コードを変えずにカードが増える。
const posts = await getPosts();
const latestPost = posts[0];
const timeline = buildTimeline(
	posts.map((post) => ({ id: post.id, date: post.data.date, title: post.data.title })),
);
---

<BaseLayout title="knowledge-flow">
	<a class="latest" href={withBase(`blog/${latestPost.id}/`)}>
		<span class="latest-label">Latest Post</span>
		<h1 class="latest-title">{latestPost.data.title}</h1>
		<time class="latest-date" datetime={latestPost.data.date.toISOString()}>
			{formatDate(latestPost.data.date)}
		</time>
	</a>
	{
		timeline.map(({ year, months }) => (
			<section class="year">
				<h2 class="year-label">{year}</h2>
				{months.map(({ month, entries }) => (
					<section class="month">
						<h3 class="month-label">{String(month).padStart(2, '0')}</h3>
						<ol class="day-strip">
							{entries.map((entry) => (
								<li class="day-card">
									<a href={withBase(`blog/${entry.id}/`)} title={entry.title}>
										<time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
										<span class="day-title">{entry.title}</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				))}
			</section>
		))
	}
</BaseLayout>

<style>
	/* 最新号は「一面のトップ記事」として扱う。囲みカードではなく、上に太めの罫、
	 * 下にヘアラインを引くだけにして、紙面のような静けさを出す。 */
	.latest {
		display: block;
		margin-top: var(--space-md);
		border-top: 2px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-md) 0 var(--space-lg);
		text-decoration: none;
	}

	.latest-label {
		display: inline-block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.latest-title {
		margin: var(--space-xs) 0 0;
		max-width: 26em;
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.latest:hover .latest-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	.latest-date {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.year {
		margin-top: var(--space-xl);
	}

	/* 年の下に罫線は引かない。直後の月ラベルが罫線を持つため、二重線になって煩くなる。 */
	.year-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.month {
		margin-top: var(--space-lg);
	}

	/* 月ラベルの右側に罫線を伸ばして、区切りであることを線そのもので示す。
	 * 見出しの下に一本引くより、横スクロール領域の始まりが分かりやすい。 */
	.month-label {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin: 0 0 var(--space-md);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
	}

	.month-label::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--color-border);
	}

	/* 月ごとの横スクロール領域。カードは日単位 */
	.day-strip {
		display: flex;
		gap: var(--space-sm);
		margin: 0;
		padding: 0 0 var(--space-xs);
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
	}

	.day-card {
		flex: 0 0 17rem;
		scroll-snap-align: start;
	}

	/* 囲みカードをやめ、左の縦罫だけで列を区切る（新聞の段組と同じ考え方）。
	 * 枠と角丸が消えるぶん、並んだ見出しそのものが視線の主役になる。 */
	.day-card a {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		height: 100%;
		border-left: 1px solid var(--color-border);
		padding: var(--space-2xs) var(--space-md) var(--space-xs);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.day-card a:hover {
		border-left-color: var(--color-accent);
	}

	.day-card a:hover .day-title {
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.day-card time {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.day-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.75;
	}

	@media (max-width: 40rem) {
		.day-card {
			flex-basis: 15rem;
		}
	}
</style>
