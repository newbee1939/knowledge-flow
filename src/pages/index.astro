---
import DayStrip from '../components/DayStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { getPosts } from '../lib/posts';
import { periodTitle } from '../lib/summaries';
import { buildTimeline } from '../lib/timeline';
import { withBase } from '../lib/url';

// タイムラインは posts からビルド時に導出する（設計原則 Derived-not-Generated）。
// docs/blog/posts/ に md を 1 枚足すだけで、コードを変えずにカードが増える。
const posts = await getPosts();
const latestPost = posts[0];

// 年・月のひとことタイトルはテンプレートで引かず、ここで畳んでおく（同じ呼び出しを 2 度書かない）
const timeline = buildTimeline(
	posts.map((post) => ({ id: post.id, date: post.data.date, title: post.data.title })),
).map((year) => ({
	...year,
	title: periodTitle(year.year),
	months: year.months.map((month) => ({ ...month, title: periodTitle(year.year, month.month) })),
}));
---

<BaseLayout title="knowledge-flow">
	<a class="latest" href={withBase(`blog/${latestPost.id}/`)}>
		<span class="latest-label">Latest Post</span>
		<h1 class="latest-title">{latestPost.data.title}</h1>
		<time class="latest-date" datetime={latestPost.data.date.toISOString()}>
			{formatDate(latestPost.data.date)}
		</time>
	</a>
	{
		timeline.map(({ year, title: yearTitle, months }) => (
			<section class="year">
				<h2 class="year-label">
					{year}
					{yearTitle && <span class="period-title">{yearTitle}</span>}
				</h2>
				{months.map(({ month, title: monthTitle, entries }) => (
					<section class="month">
						<h3 class="month-label">
							{String(month).padStart(2, '0')}
							{monthTitle && <span class="period-title">{monthTitle}</span>}
						</h3>
						<DayStrip
							items={entries.map((entry) => ({
								href: withBase(`blog/${entry.id}/`),
								date: entry.date,
								title: entry.title,
							}))}
						/>
					</section>
				))}
			</section>
		))
	}
</BaseLayout>

<style>
	.latest {
		display: block;
		margin-top: var(--space-md);
		border-top: 2px solid var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-md) 0 var(--space-lg);
		text-decoration: none;
	}

	.latest-label {
		display: inline-block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.latest-title {
		margin: var(--space-xs) 0 0;
		max-width: 26em;
		font-size: var(--text-2xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.latest:hover .latest-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	.latest-date {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.year {
		margin-top: var(--space-xl);
	}

	/* 年の下に罫線は引かない。直後の月ラベルが罫線を持つため二重線になる。 */
	.year-label {
		display: flex;
		align-items: baseline;
		gap: var(--space-md);
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.month {
		margin-top: var(--space-lg);
	}

	.month-label {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin: 0 0 var(--space-md);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
	}

	.month-label::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--color-border);
	}

	/* 年月の数字（等幅・字間広め）と地続きに見えないよう、和文は本文の書体に戻す */
	.period-title {
		flex: 0 1 auto;
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0;
	}

	.year-label .period-title {
		font-size: var(--text-sm);
	}
</style>
