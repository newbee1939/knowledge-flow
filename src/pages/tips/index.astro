---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { getTips } from '../../lib/posts';
import { withBase } from '../../lib/url';

const tips = await getTips();
---

<BaseLayout title="Tips | knowledge-flow" description="技術トピックの解説記事。日次レポートの用語はここに繋がる">
	<div class="intro">
		<h1>Tips</h1>
		<p>
			日次レポートに出てくる技術やサービスを、単体で読める形にまとめたものです。レポートの要約と違い、運営者が自分で書いています。
		</p>
	</div>
	<ul class="tip-list">
		{
			tips.map((tip) => (
				<li>
					<a class="tip" href={withBase(`tips/${tip.id}/`)}>
						<h2 class="tip-title">{tip.data.title}</h2>
						<p class="tip-description">{tip.data.description}</p>
						<time class="tip-date" datetime={tip.data.updated.toISOString()}>
							{formatDate(tip.data.updated)}
						</time>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.intro {
		max-width: var(--container-article);
		margin-inline: auto;
		padding-top: var(--space-xl);
	}

	.intro h1 {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.intro p {
		margin: var(--space-sm) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.tip-list {
		max-width: var(--container-article);
		margin: var(--space-lg) auto 0;
		padding: 0;
		list-style: none;
	}

	.tip {
		display: block;
		border-top: 1px solid var(--color-border);
		padding: var(--space-md) 0;
		text-decoration: none;
	}

	.tip-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		line-height: 1.6;
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
	}

	.tip:hover .tip-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
	}

	.tip-description {
		margin: var(--space-2xs) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.tip-date {
		display: block;
		margin-top: var(--space-xs);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
</style>
