---
import { render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;

// rehype-mermaid の描画に失敗すると、Astro の glob loader はエラーをログに出すだけで
// 本文を空のまま握りつぶし、ビルドは exit 0 で成功してしまう（Mermaid 構文エラーなどが
// 人間のレビュー無しで main に push される P3 の運用では、誰も気づけないまま空記事が
// 公開されかねない）。posts.ts の「0 件ならビルドを止める」ガードと同じ思想で、
// ここでも壊れた記事を検知したらビルドを止める。
if (!post.rendered?.html) {
	throw new Error(
		`記事 ${post.id} の本文レンダリングに失敗しました。Mermaid 図などの構文エラーがないか確認してください。`,
	);
}

const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
	<article class="post">
		<header class="post-header">
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
			<h1>{post.data.title}</h1>
		</header>
		<Prose>
			<Content />
		</Prose>
	</article>
</BaseLayout>

<style>
	.post {
		max-width: var(--container-article);
		margin-inline: auto;
		padding-top: var(--space-xl);
	}

	.post-header time {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.post-header h1 {
		margin: var(--space-xs) 0 0;
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: 1.55;
		letter-spacing: -0.01em;
	}
</style>
