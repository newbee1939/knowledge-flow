---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectCategories } from '../../lib/categories';
import { getArticles } from '../../lib/posts';
import { withBase } from '../../lib/url';

// カテゴリは posts の本文からビルド時に導出する（設計原則 Derived-not-Generated）。
// getArticles() は新しい順なので、カテゴリ内の記事もそのまま新しい順になる。
const categories = collectCategories(await getArticles());
---

<BaseLayout title="Categories | knowledge-flow" description="Browse tech news by category in chronological order">
	<label class="sort-toggle">
		<input type="checkbox" />
		投稿数順
	</label>
	<ul class="category-list">
		{
			categories.map((category) => (
				<li style={`--count: ${category.articles.length}`}>
					<a class="category-chip" href={withBase(`categories/${category.slug}/`)}>
						<span class="category-name">{category.name}</span>
						<span class="category-count">{category.articles.length}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.sort-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		margin-top: var(--space-lg);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		cursor: pointer;
	}

	/* JS 無しで並べ替える。order は降順にするため符号反転し、同数は DOM 順（名前順）のまま */
	.sort-toggle:has(input:checked) + .category-list li {
		order: calc(-1 * var(--count));
	}

	.category-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
	}

	.category-chip {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-xs);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-2xs) var(--space-sm);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.category-chip:hover {
		border-color: var(--color-text);
	}

	.category-name {
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.category-count {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
</style>
