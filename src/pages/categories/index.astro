---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectCategories } from '../../lib/categories';
import { getArticles } from '../../lib/posts';
import { withBase } from '../../lib/url';

// カテゴリは posts の本文からビルド時に導出する（設計原則 Derived-not-Generated）。
// getArticles() は新しい順なので、カテゴリ内の記事もそのまま新しい順になる。
const categories = collectCategories(await getArticles());
---

<BaseLayout title="Categories | knowledge-flow" description="Browse tech news by category in chronological order">
	<ul class="category-list">
		{
			categories.map((category) => (
				<li>
					<a class="category-chip" href={withBase(`categories/${category.slug}/`)}>
						<span class="category-name">{category.name}</span>
						<span class="category-count">{category.articles.length}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.category-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin: var(--space-lg) 0 0;
		padding: 0;
		list-style: none;
	}

	.category-chip {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-xs);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-2xs) var(--space-sm);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.category-chip:hover {
		border-color: var(--color-text);
	}

	.category-name {
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.category-count {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
</style>
