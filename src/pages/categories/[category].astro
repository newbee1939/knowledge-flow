---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractArticles } from '../../lib/articles';
import { collectCategories } from '../../lib/categories';
import { formatDate } from '../../lib/date';
import { getPosts } from '../../lib/posts';
import { buildTimeline } from '../../lib/timeline';
import { withBase } from '../../lib/url';

// ファイル名の [category] は動的ルート。静的ビルドでは「どの URL を何ページ作るか」を
// ビルド時に確定させる必要があり、その一覧を Astro に教えるのが getStaticPaths。
// 返す配列の 1 要素 = 生成される 1 ページ。params.category が URL の [category] 部分を
// 埋め（/categories/typescript/ など）、props はそのページの Astro.props にそのまま渡る。
// つまりこのテンプレートは「雛形」で、カテゴリの数（1 要素 = 1 カテゴリ）だけ実行される。
export async function getStaticPaths() {
	const posts = await getPosts();
	const articles = posts.flatMap((post) =>
		extractArticles({ postId: post.id, date: post.data.date, body: post.body ?? '' }),
	);
	return collectCategories(articles).map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;

// トップページと同じ年 → 月構造で「その技術単一の歴史」を縦に辿る
const timeline = buildTimeline(category.articles);
---

<BaseLayout
	title={`${category.name} | knowledge-flow`}
	description={`Browse ${category.name} news in chronological order`}
>
	<header class="page-header">
		<a class="back-link" href={withBase('categories/')}>← Categories</a>
		<h1 class="page-title">{category.name}</h1>
		<p class="page-description">{category.articles.length} 件の記事</p>
	</header>
	{
		timeline.map(({ year, months }) => (
			<section class="year">
				<h2 class="year-label">{year}</h2>
				{months.map(({ month, entries }) => (
					<section class="month">
						<h3 class="month-label">{String(month).padStart(2, '0')}</h3>
						<ol class="article-list">
							{entries.map((article) => (
								<li class="article-item">
									<a href={withBase(`blog/${article.postId}/#${article.anchor}`)}>
										<time datetime={article.date.toISOString()}>{formatDate(article.date)}</time>
										<span class="article-title">{article.title}</span>
									</a>
								</li>
							))}
						</ol>
					</section>
				))}
			</section>
		))
	}
</BaseLayout>

<style>
	.page-header {
		margin-top: var(--space-md);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
	}

	.back-link {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-decoration: none;
		text-underline-offset: 0.35em;
	}

	.back-link:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.page-title {
		margin: var(--space-sm) 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xl);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.page-description {
		margin: var(--space-2xs) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.year {
		margin-top: var(--space-xl);
	}

	/* 年の下に罫線は引かない。直後の月ラベルが罫線を持つため、二重線になって煩くなる。 */
	.year-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.month {
		margin-top: var(--space-lg);
	}

	/* 月ラベルの右側に罫線を伸ばす（トップページと同じ扱い） */
	.month-label {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin: 0 0 var(--space-xs);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
	}

	.month-label::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--color-border);
	}

	.article-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* 日付を固定幅の 1 段目に置いて、タイトルの頭を縦に揃える。行ごとに開始位置が
	 * ずれないだけで、長い一覧はかなり読みやすくなる。 */
	.article-item a {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		align-items: baseline;
		gap: var(--space-md);
		border-bottom: 1px solid var(--color-border);
		padding: var(--space-sm) var(--space-2xs);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.article-item a:hover {
		border-bottom-color: var(--color-text);
	}

	.article-item a:hover .article-title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
	}

	.article-item time {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
	}

	.article-title {
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.75;
	}

	@media (max-width: 40rem) {
		.article-item a {
			grid-template-columns: 1fr;
			gap: var(--space-2xs);
		}
	}
</style>
