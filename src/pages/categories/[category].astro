---
import Timeline from '../../components/Timeline.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectCategories } from '../../lib/categories';
import { getArticles } from '../../lib/posts';
import { withBase } from '../../lib/url';

// ファイル名の [category] は動的ルート。静的ビルドでは「どの URL を何ページ作るか」を
// ビルド時に確定させる必要があり、その一覧を Astro に教えるのが getStaticPaths。
// 返す配列の 1 要素 = 生成される 1 ページ。params.category が URL の [category] 部分を
// 埋め（/categories/typescript/ など）、props はそのページの Astro.props にそのまま渡る。
// つまりこのテンプレートは「雛形」で、カテゴリの数（1 要素 = 1 カテゴリ）だけ実行される。
export async function getStaticPaths() {
	return collectCategories(await getArticles()).map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
---

<BaseLayout
	title={`${category.name} | knowledge-flow`}
	description={`Browse ${category.name} news in chronological order`}
>
	<header class="page-header">
		<a class="back-link" href={withBase('categories/')}>← Categories</a>
		<h1 class="page-title">{category.name}</h1>
		<p class="page-description">{category.articles.length} 件の記事</p>
	</header>
	<Timeline
		category={category.name}
		items={category.articles.map((article) => ({
			href: withBase(`blog/${article.postId}/#${article.anchor}`),
			date: article.date,
			title: article.title,
		}))}
	/>
</BaseLayout>

<style>
	.page-header {
		margin-top: var(--space-md);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
	}

	.back-link {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-decoration: none;
		text-underline-offset: 0.35em;
	}

	.back-link:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.page-title {
		margin: var(--space-sm) 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-2xl);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.page-description {
		margin: var(--space-2xs) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}
</style>
